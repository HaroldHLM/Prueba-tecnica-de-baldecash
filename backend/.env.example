# URL de conexión a PostgreSQL. Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgresql://baldecash:baldecash@localhost:5435/baldecash"

# URL del frontend, para habilitar CORS.
FRONTEND_URL="http://localhost:3001"

# Tasa de interes anual para el calculo de la cuota (0.24 = 24%).
TASA_INTERES_ANUAL="0.24"
